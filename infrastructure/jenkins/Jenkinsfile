pipeline {
    agent any
    
    tools {
        maven 'Maven'
    }

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-21-amazon-corretto'
        PATH = "${JAVA_HOME}/bin:${PATH}"
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 1, unit: 'HOURS')
        timestamps()
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "✓ Repository checked out"
            }
        }

        stage('Build Backend') {
            steps {
                dir('apps/business-backend') {
                    sh '''
                        # Clear Maven cache for surefire to fix cached dependency failure
                        rm -rf ~/.m2/repository/org/junit/platform ~/.m2/repository/org/apache/maven/plugins/maven-surefire-plugin
                        # Build without tests
                        mvn -B clean package -DskipTests -U
                    '''
                    echo "✓ Backend built"
                }
            }
        }

        stage('Build Frontend') {
            steps {
                sh '''
                    cd apps/business-logic-ui
                    npm install --legacy-peer-deps
                    npm run build
                    echo "✓ Frontend built"
                '''
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'apps/business-backend/target/*.jar',
                                  allowEmptyArchive: true
                archiveArtifacts artifacts: 'apps/business-logic-ui/dist/**/*',
                                  allowEmptyArchive: true
                echo "✓ Artifacts archived"
            }
        }
    }
    
    post {
        success {
            echo "✅ Build SUCCESS"
        }
        failure {
            echo "❌ Build FAILED"
        }
    }
}
