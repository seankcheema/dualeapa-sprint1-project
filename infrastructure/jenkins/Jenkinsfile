pipeline {
    agent any
    
    tools {
        maven 'Maven'
    }

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-21-amazon-corretto'
        PATH = "${JAVA_HOME}/bin:${PATH}"
        DOCKER_BUILDKIT = '1'
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 1, unit: 'HOURS')
        timestamps()
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "✓ Repository checked out"
            }
        }

        stage('Parallel: Backend & Frontend Build') {
            parallel {
                stage('Backend Build') {
                    steps {
                        dir('apps/business-backend') {
                            sh 'mvn -B clean package -DskipTests'
                            echo "✓ Backend built successfully"
                        }
                    }
                }

                stage('Frontend Build') {
                    steps {
                        sh '''
                            docker run --rm \
                                -v "$(pwd)/apps/business-logic-ui:/app" \
                                -w /app \
                                node:22-alpine \
                                sh -c "npm ci --prefer-offline --no-audit && npm run build"
                            echo "✓ Frontend built successfully"
                        '''
                    }
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                script {
                    echo "📦 Archiving build artifacts..."
                    archiveArtifacts artifacts: 'apps/business-backend/target/sprint1-greeter-app.jar',
                                      allowEmptyArchive: true,
                                      fingerprint: true

                    archiveArtifacts artifacts: 'apps/business-logic-ui/dist/**/*',
                                      allowEmptyArchive: true,
                                      fingerprint: true

                    echo "✓ Artifacts archived"
                }
            }
        }
    }
    
    
    post {
        always {
            echo "🧹 Cleanup completed"
        }
        success {
            echo "✅ Pipeline SUCCESS - Build completed"
        }
        failure {
            echo "❌ Pipeline FAILED - Check logs above for details"
        }
    }
}
