pipeline {
    agent any
    
    tools {
        maven 'Maven'
    }

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-21-amazon-corretto'
        PATH = "${JAVA_HOME}/bin:${PATH}"
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 1, unit: 'HOURS')
        timestamps()
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "✓ Repository checked out"
            }
        }

        stage('Setup Dependencies') {
            parallel {
                stage('Cache Maven') {
                    steps {
                        dir('apps/business-backend') {
                            sh '''
                                # Clear Maven cache for surefire to fix cached dependency failure
                                rm -rf ~/.m2/repository/org/junit/platform ~/.m2/repository/org/apache/maven/plugins/maven-surefire-plugin
                                # Warm up Maven cache
                                mvn -B dependency:resolve dependency:resolve-plugins -q
                                echo "✓ Maven dependencies cached"
                            '''
                        }
                    }
                }
                
                stage('Cache NPM') {
                    steps {
                        dir('apps/business-logic-ui') {
                            sh '''
                                npm install --legacy-peer-deps
                                echo "✓ NPM dependencies cached"
                            '''
                        }
                    }
                }
            }
        }

        stage('Run Tests') {
            parallel {
                stage('Backend Tests') {
                    steps {
                        dir('apps/business-backend') {
                            sh '''
                                echo "🧪 Running Backend Tests (Unit + Integration)..."
                                mvn -B clean test
                                echo "✓ Backend tests completed"
                            '''
                        }
                    }
                }
                
                stage('Frontend Tests') {
                    steps {
                        dir('apps/business-logic-ui') {
                            sh '''
                                echo "🧪 Running Frontend Tests (Vitest)..."
                                npm test -- --run --coverage
                                echo "✓ Frontend tests completed"
                            '''
                        }
                    }
                }
            }
        }

        stage('Archive Test Results') {
            steps {
                // Archive Backend test reports
                archiveArtifacts artifacts: 'apps/business-backend/target/surefire-reports/**/*',
                                  allowEmptyArchive: true
                
                // Archive Frontend coverage reports
                archiveArtifacts artifacts: 'apps/business-logic-ui/coverage/**/*',
                                  allowEmptyArchive: true
                
                echo "✓ Test reports archived"
            }
        }

        stage('Publish Test Results') {
            steps {
                // Publish JUnit test results from backend
                junit testResults: 'apps/business-backend/target/surefire-reports/**/*.xml',
                      allowEmptyResults: true,
                      healthScaleFactor: 1.0
                
                echo "✓ Test results published to Jenkins dashboard"
            }
        }
    }
    
    post {
        always {
            // Clean up any temporary files
            cleanWs(deleteDirs: true, patterns: [[pattern: '**/node_modules', type: 'INCLUDE']])
        }
        
        success {
            echo "✅ All Tests PASSED"
        }
        
        failure {
            echo "❌ Tests FAILED - Review test results in Jenkins dashboard"
        }
        
        unstable {
            echo "⚠️  Build is UNSTABLE - Some tests may have failed or timed out"
        }
    }
}
