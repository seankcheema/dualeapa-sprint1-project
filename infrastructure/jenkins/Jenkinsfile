pipeline {
    agent any
    
    tools {
        maven 'Maven'
    }

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-21-amazon-corretto'
        PATH = "${JAVA_HOME}/bin:${PATH}"
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 1, unit: 'HOURS')
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                dir('apps/business-backend') {
                    sh 'mvn -B clean package -DskipTests'
                    // fast, DB-free unit tests only; DB-backed integration tests run in the Test stage
                    sh 'mvn -B test -Dgroups=unit'
                }
            }
        }
        stage('Test') {
            steps {
                sh '''
                    docker rm -f test-db >/dev/null 2>&1 || true
                    docker run -d --name test-db \
                        -e POSTGRES_DB=leap_test \
                        -e POSTGRES_USER=leap \
                        -e POSTGRES_PASSWORD=changeme \
                        -p 5432:5432 \
                        -v "$WORKSPACE/apps/business-backend/db/init.sql:/docker-entrypoint-initdb.d/schema.sql:ro" \
                        postgres:16-alpine

                    for i in $(seq 1 30); do
                        docker exec test-db pg_isready -U leap -d leap_test >/dev/null 2>&1 && break
                        sleep 1
                    done
                '''
                dir('apps/business-backend') {
                    sh 'mvn -B test -DexcludedGroups=unit || true'
                }
            }
            post {
                always {
                    sh 'docker rm -f test-db >/dev/null 2>&1 || true'
                    junit testResults: 'apps/business-backend/target/surefire-reports/*.xml', 
                          allowEmptyResults: true
                }
            }
        }
        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'apps/business-backend/target/*.jar', fingerprint: true
            }
        }
        stage('Angular Install') {
            steps {
                // Clean install dependencies
                // Note: Requires Node.js 22 installed on Jenkins server
                sh 'npm ci'
                sh 'cd apps/business-logic-ui && npm ci'
            }
        }
        stage('Angular Build') {
            steps {
                dir('apps/business-logic-ui') {
                    sh 'npm run build'
                }
            }
        }
        stage('Angular Test') {
            steps {
                dir('apps/business-logic-ui') {
                    sh 'npm test -- --watch=false || true'
                }
            }
        }
        stage('Docker Build (Multistage)') {
            steps {
                sh 'docker build -t team-skeleton:multistage .'
            }
        }
        stage('Docker Compose Up') {
            steps {
                sh 'docker-compose up -d'
                sh 'docker-compose ps'
            }
        }
        stage('Docker Compose Down') {
            steps {
                sh 'docker-compose down'
            }
        }
        stage('Debug - Manual Build Test') {
            when {
                expression { env.RUN_DEBUG == 'true' }
            }
            steps {
                sh '''
                    cd /home/ec2-user/dualeapa-sprint1-project
                    cd apps/business-backend && mvn clean package
                '''
            }
        }
    }
    
    post {
        always {
            sh 'docker-compose down || true'
            echo "Pipeline Status: ${currentBuild.result}"
            junit testResults: 'target/surefire-reports/*.xml', 
                  allowEmptyResults: true
        }
        success {
            echo '✓ Build SUCCESS - Ready for deployment'
        }
        failure {
            echo '✗ Build FAILED - Check logs for details'
        }
    }
}
